{
  "expo": {
    "name": "Habitualize",
    "slug": "habitualize",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "sdkVersion": "54.0.0",
    "splash": {
      "backgroundColor": "#121212"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.habitualize.app"
    },
    "android": {
      "package": "com.habitualize.app",
      "adaptiveIcon": {
        "backgroundColor": "#121212"
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset",
      "expo-font"
    ]
  }
}
