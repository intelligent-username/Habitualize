<?xml version='1.0' encoding='utf-8'?>
<Wix xmlns='http://schemas.microsoft.com/wix/2006/wi'>
  <Product
    Id='*'
    Name='Habitualize'
    UpgradeCode='12345678-1234-1234-1234-111111111111'
    Manufacturer='Varak Tanashian'
    Language='1033'
    Codepage='1252'
    Version='$(var.Version)'>

    <Package Id='*' Keywords='Installer' Description='Habitualize Installer'
      Comments='Habitualize is a lightning-fast habit tracker' Manufacturer='Varak Tanashian'
      InstallerVersion='100' Languages='1033' Compressed='yes' SummaryCodepage='1252' />

    <MajorUpgrade DowngradeErrorMessage='A newer version of [ProductName] is already installed.' />

    <Media Id='1' Cabinet='Sample.cab' EmbedCab='yes' DiskPrompt='CD-ROM #1' />
    <Property Id='DiskPrompt' Value='Habitualize Installation [1]' />

    <Directory Id='TARGETDIR' Name='SourceDir'>
      <Directory Id='ProgramFilesFolder' Name='PFiles'>
        <Directory Id='APPLICATIONFOLDER' Name='Habitualize'>
          <Directory Id='BACKENDFOLDER' Name='backend' />
          <Directory Id='SCRIPTSFOLDER' Name='scripts' />
        </Directory>
      </Directory>
      <Directory Id='ProgramMenuFolder'>
        <Directory Id='ApplicationProgramsFolder' Name='Habitualize' />
      </Directory>
    </Directory>

    <DirectoryRef Id='APPLICATIONFOLDER'>
      <Component Id='MainExecutable' Guid='12345678-1234-1234-1234-222222222222'>
        <!-- Make sure this file exists in the build output directory -->
        <File Id='MainExe' Source='$(var.CargoTargetBinDir)\$(var.BinaryName).exe' KeyPath='yes' />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id='BACKENDFOLDER'>
      <Component Id='BackendFiles' Guid='12345678-1234-1234-1234-333333333333'>
        <File Id='AppPy' Source='backend\app.py' KeyPath='yes' />
        <File Id='RequirementsTxt' Source='backend\requirements.txt' />
        <File Id='DataDb' Source='backend\data.db' />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id='SCRIPTSFOLDER'>
      <Component Id='ScriptFiles' Guid='12345678-1234-1234-1234-444444444444'>
        <File Id='InstallScript' Source='scripts\install_dependencies_windows.bat' KeyPath='yes' />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id='ApplicationProgramsFolder'>
      <Component Id='ApplicationShortcut' Guid='12345678-1234-1234-1234-555555555555'>
        <Shortcut Id='ApplicationStartMenuShortcut' Name='Habitualize' Description='Lightning-fast habit tracker'
          Target='[APPLICATIONFOLDER]$(var.BinaryName).exe' WorkingDirectory='APPLICATIONFOLDER' />
        <RemoveFolder Id='ApplicationProgramsFolder' On='uninstall' />
        <RegistryValue Root='HKCU' Key='Software\Microsoft\Habitualize' Name='installed' Type='integer' Value='1' KeyPath='yes' />
      </Component>
    </DirectoryRef>

    <!-- Custom action to run dependency installer -->
    <CustomAction Id='InstallDependencies' FileKey='InstallScript' ExeCommand='' Execute='deferred' Return='check' Impersonate='no' />

    <InstallExecuteSequence>
      <Custom Action='InstallDependencies' After='InstallFiles'>NOT Installed</Custom>
    </InstallExecuteSequence>

    <Feature Id='MainApplication' Title='Main Application' Level='1'>
      <ComponentRef Id='MainExecutable' />
      <ComponentRef Id='BackendFiles' />
      <ComponentRef Id='ScriptFiles' />
      <ComponentRef Id='ApplicationShortcut' />
    </Feature>

    <UI />
    <UIRef Id='WixUI_Minimal' />
  </Product>
</Wix>
